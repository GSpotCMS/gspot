{
    "name": "gspot/gspot",
    "description": "GSpot CMS — A flat-file, MCP-native content management system. Find the Spot. Hit it. Ship it.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "illuminate/view": "^11.0",
        "illuminate/filesystem": "^11.0",
        "illuminate/events": "^11.0",
        "illuminate/container": "^11.0",
        "league/commonmark": "^2.10.2",
        "symfony/yaml": "^7.4.18",
        "symfony/http-foundation": "^7.4.19",
        "stripe/stripe-php": "^16.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "GSpot\\": "system/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GSpot\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/gspot"],
    "scripts": {
        "serve": "php -S localhost:8080 -t public system/server.php",
        "test": "phpunit",
        "lint": "php scripts/lint-php.php",
        "smoke-install": "bash scripts/smoke-create-project.sh"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
