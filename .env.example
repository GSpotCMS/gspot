# Copy to .env for local dev (never commit .env)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: shop owner inbox for order receipt copies (also written to user/plugins/commerce/data/receipts/)
COMMERCE_NOTIFY_EMAIL=you@example.com
COMMERCE_BUYER_RECEIPTS=1
COMMERCE_CRON_KEY=change-me-for-abandoned-cart-cron
STRIPE_AUTOMATIC_TAX=0

# Local webhook forwarding: stripe listen --forward-to localhost:8080/commerce/webhook/stripe
